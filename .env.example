# --- режимы (переключение только здесь, кода не касаемся) -------------------
# SERVICE: bot | backend | all
# MODE:    mock | real
SERVICE=bot
MODE=mock

# Точечное перекрытие режима порта: MODE=mock + ADAPTER_LLM=real
# ADAPTER_USERS=real
# ADAPTER_CATALOG=real
# ADAPTER_DIALOG=real
# ADAPTER_CALC=real
# ADAPTER_ANALYSIS=real
# ADAPTER_BILLING=real
# ADAPTER_NOTIFY=real
# ADAPTER_BACKEND=real

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
BOT_USERNAME=
MINIAPP_URL=
ADMIN_CHAT_ID=

# --- внутренний контракт ----------------------------------------------------
INTERNAL_TOKEN=dev-internal-token
# Секрет подписи (в prod обязателен, ≥32 символов)
APP_SECRET_KEY=dev-secret-change-me

# --- адреса -----------------------------------------------------------------
BACKEND_URL=http://localhost:8000
# MODE=real: legacy auto_bot API — источник правды на время миграции
LEGACY_BACKEND_URL=
REDIS_URL=

# --- прочее -----------------------------------------------------------------
LOG_LEVEL=INFO
HTTP_TIMEOUT_SEC=10
DIALOG_TIMEOUT_SEC=120
